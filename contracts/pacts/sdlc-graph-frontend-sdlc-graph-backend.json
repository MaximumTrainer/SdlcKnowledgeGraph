        "method": "GET",
        "path": "/api/v1/nodes/Team"
      },
      "response": {
        "body": {
          "items": [
            {
              "id": "Team:platform",
              "key": "platform",
              "props": {
                "name": "platform"
              },
              "type": "Team"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.items": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            }
          },
          "header": {},
          "status": {}
        },
        "status": 200
      }
    },
