{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "conformance.config.ts",
    "auth.config.ts",
    "tests/**/*.ts",
    "conformance/**/*.ts",
    "auth/**/*.ts"
  ]
}
