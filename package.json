{
  "name": "sdlc-knowledge-graph",
  "version": "0.0.1",
  "private": true,
  "description": "Root workspace tooling for the SDLC Knowledge Graph: git hooks (lefthook), commit message linting (commitlint) and the commit-time guards (hygiene, secretlint).",
  "scripts": {
    "prepare": "lefthook install",
    "gradle": "node scripts/gradle.mjs",
    "commitlint": "commitlint",
    "actionlint": "node scripts/actionlint.mjs",
    "hooks:install": "lefthook install --force",
    "hooks:validate": "lefthook validate",
    "secretlint": "node scripts/secretlint.mjs",
    "hygiene": "node scripts/hygiene.mjs",
    "guards": "node scripts/guards.mjs",
    "test:unit": "node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "actionlint": "^2.0.6",
    "lefthook": "^2.1.12",
    "secretlint": "^13.0.5"
  }
}
