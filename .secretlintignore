# Paths secretlint must not scan. Keep this short: everything excluded here is a place a leaked
# credential would go unnoticed.
#
# Lock files and build output are generated, never hand-edited, and large enough to slow the hook.
**/node_modules/**
**/package-lock.json
**/dist/**
**/build/**
**/.vitepress/cache/**
**/coverage/**
**/playwright-report/**
**/test-results/**
backend/.gradle/**
backend/gradle/wrapper/gradle-wrapper.jar
