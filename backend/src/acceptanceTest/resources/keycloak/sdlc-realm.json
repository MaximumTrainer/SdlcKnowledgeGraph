  "defaultDefaultClientScopes": [
    "role_list",
    "saml_organization",
    "profile",
    "email",
    "roles",
    "web-origins",
    "acr",
    "basic"
  ],
  "defaultOptionalClientScopes": [
    "offline_access",
    "address",
    "phone",
    "microprofile-jwt",
    "organization"
  ],
  "scopeMappings": [
    {
      "clientScope": "graph:read",
      "roles": [
        "graph-reader"
      ]
    },
    {
      "clientScope": "graph:write",
      "roles": [
        "graph-writer"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "sdlc-ui",
      "name": "SDLC Knowledge Graph web interface",
      "description": "The Vue single-page application. Public, so it holds no secret; PKCE protects the code exchange.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:3000/*"
      },
      "defaultClientScopes": [
        "role_list",
        "saml_organization",
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr",
        "basic",
        "graph:read",
        "graph:write"
      ],
      "optionalClientScopes": [
        "offline_access",
        "address",
        "phone",
        "microprofile-jwt",
        "organization"
      ]
    },
    {
      "clientId": "github-connector",
      "name": "GitHub connector",
      "description": "An example connector principal (#115). Client credentials; the secret is a development value, never used outside this realm.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "github-connector-dev-only",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "role_list",
        "saml_organization",
        "profile",
        "email",
        "roles",
        "web-origins",
        "acr",
        "basic",
        "graph:read",
        "graph:write",
        "graph:write:github",
        "graph:write:github-actions"
      ],
      "optionalClientScopes": [
        "offline_access",
        "address",
        "phone",
        "microprofile-jwt",
        "organization"
      ]
    },
    {
      "clientId": "triage-agent",
      "name": "Triage agent",
      "description": "An example agent principal (#115). Client credentials; the secret is a development value, never used outside this realm.",
      "enabled": true,
      "protocol": "openid-connect",
