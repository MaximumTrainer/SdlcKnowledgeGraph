{
  "realm": "sdlc",
  "displayName": "SDLC Knowledge Graph (development)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "sdlc-ui",
      "name": "SDLC Knowledge Graph web interface",
      "description": "The Vue single-page application. Public, so it holds no secret; PKCE protects the code exchange.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      }
    },
    {
      "clientId": "github-connector",
      "name": "GitHub connector",
      "description": "An example connector principal (#115). Client credentials; the secret is a development value, never used outside this realm.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "github-connector-dev-only",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "triage-agent",
      "name": "Triage agent",
      "description": "An example agent principal (#115). Client credentials; the secret is a development value, never used outside this realm.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "triage-agent-dev-only",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "rogue-agent",
      "name": "Unregistered agent",
      "description": "A client Keycloak trusts but the graph has no registration for, so the API refuses it (#115). Development only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "rogue-agent-dev-only",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "id": "dan",
      "username": "dan",
      "enabled": true,
      "email": "dan@example.test",
      "emailVerified": true,
      "firstName": "Dan",
      "lastName": "Developer",
      "credentials": [{ "type": "password", "value": "dan", "temporary": false }]
    }
  ]
}
