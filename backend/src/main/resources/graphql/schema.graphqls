type Query {
    repository(id: ID!): Repository
    repositories: [Repository!]!
    cloudResourcesForRepo(repoId: ID!): [CloudResource!]!
    dependenciesForRepo(repoId: ID!): [Repository!]!
    dependentsForRepo(repoId: ID!): [Repository!]!
    deploymentsForRepo(repoId: ID!): [Deployment!]!
    teamForRepo(repoId: ID!): Team
    pipelinesForRepo(repoId: ID!): [Pipeline!]!
    impactAnalysis(repoId: ID!): ImpactAnalysis!
    auditEventsForRepo(repoId: ID!): [AuditEvent!]!
    "What a change to a node reaches, with the path and confidence that explain each node (#21). nodeId is Type:key."
    impact(nodeId: ID!, depth: Int = 3, minConfidence: Float = 0.5, direction: ImpactDirection = DOWNSTREAM): Impact!
    "Why a deployment failed: its lineage, the last success before it and the dependencies deployed since (#21)."
    whyDeploymentFailed(id: ID!): WhyFailed!
    """
    What a change to a repository reaches, ranked, with owners and a citation per hit (#87): the same answer as
    POST /api/v1/impact. Named changeImpact because impact is #21's blast radius, and GraphQL cannot overload a field.
    """
    changeImpact(input: ChangeImpactInput!): ChangeImpact!
}

type Mutation {
    registerRepository(input: RepositoryInput!): Repository!
    deleteRepository(id: ID!): Boolean!
    linkRepoToTeam(repoId: ID!, teamId: ID!): Boolean!
    linkRepoToCloudResource(repoId: ID!, resourceId: ID!): Boolean!
    addRepoDependency(fromRepoId: ID!, toRepoId: ID!): Boolean!
}

type Repository {
    id: ID!
    url: String!
    "org/name, derived from url and emitted for compatibility; not accepted on input (#88)."
    orgRepo: String!
    provider: String
    providerId: String
    defaultBranch: String!
    topics: [String!]!
    codeowners: [String!]!
    serviceId: String
    language: String
    description: String
}

type Team {
    id: ID!
    name: String!
    email: String
}

type CloudResource {
    id: ID!
    provider: String!
    resourceType: String!
    name: String!
    region: String
    repoId: String
}

type Artifact {
    id: ID!
    name: String!
    version: String!
    commitSha: String
    repoId: String
    artifactType: String!
}

type Deployment {
    id: ID!
    artifactId: ID!
    environmentId: ID!
    deployedAt: String!
    deployedBy: String
    status: String!
}

type Environment {
    id: ID!
    name: String!
    type: String!
}

type Pipeline {
    id: ID!
    name: String!
    provider: String!
    repoId: ID!
    lastRunStatus: String
}

type AuditEvent {
    id: ID!
    eventType: String!
    repoId: String
    artifactId: String
    actor: String
    timestamp: String!
}

"Deprecated with GET /api/v1/graph/repositories/{repoId}/impact: use Query.impact."
type ImpactAnalysis {
    repoId: ID!
    dependents: [Repository!]!
    cloudResources: [CloudResource!]!
    deployments: [Deployment!]!
}

"orgRepo is derived from url and no longer accepted (#88); it is still emitted on Repository."
input RepositoryInput {
    "The git remote, in any written form."
    url: String!
    defaultBranch: String
    topics: [String!]
    codeowners: [String!]
    serviceId: String
    language: String
    description: String
}

# Impact analysis (#21). Nodes are the generated GraphNode types (schema.generated.graphqls), so a new
# node type in the registry is answerable here without a schema change.

enum ImpactDirection {
    DOWNSTREAM
    UPSTREAM
}

"One hop of an explanation: the edge as walked - its inverse name when walked against its direction - and its confidence."
type ImpactStep {
    edge: String!
    from: ID!
    to: ID!
    confidence: Float!
    inferred: Boolean!
}

type AffectedNode {
    node: GraphNode!
    distance: Int!
    "The product of the provenance confidence of the edges on path."
    confidence: Float!
    "True when path holds an inferred edge."
    inferred: Boolean!
    path: [ImpactStep!]!
}

"Affected nodes of one type; the type 'excluded' counts those below minConfidence."
type TypeCount {
    type: String!
    count: Int!
}

type Impact {
    root: GraphNode!
    depth: Int!
    direction: ImpactDirection!
    minConfidence: Float!
    "True when more than 1000 nodes were reached, or the walk was cut short."
    truncated: Boolean!
    affected: [AffectedNode!]!
    byType: [TypeCount!]!
}

type DeploymentRecord {
    id: ID!
    repository: ID
    commitSha: String
    deployedAt: String!
    status: String!
}

type FailureReason {
    kind: String!
    detail: String!
}

type WhyFailed {
    deployment: GraphNode!
    status: String!
    deployedAt: String!
    artifact: GraphNode
    commitSha: String
    repository: GraphNode
    pipeline: GraphNode
    environment: GraphNode
    changedDependencies: [DeploymentRecord!]!
    precedingSuccessfulDeployment: DeploymentRecord
    reasons: [FailureReason!]!
}

# Impact analysis of a change (#87), ranked for an agent's context pack.

input ChangeImpactInput {
    "Key of the Repository that is about to change, e.g. github.com/acme/payments. This or providerId is required."
    repositoryKey: String
    "The provider's id for the repository, consulted before repositoryKey; it survives a rename (#88)."
    providerId: String
    "Who assigns providerId: github (the default), gitlab or other."
    provider: String
    "Paths the change touches, read against the repository's manifest and IaC index where it has one."
    paths: [String!]
    "The commit of the change, 4 to 64 hex characters. Keeps only deployments whose Artifact CONTAINS a matching Change (#85)."
    sha: String
    "Hops to walk, 1 to 4."
    depth: Int = 2
    "Hits to return, 1 to 500."
    limit: Int = 50
}

type TierWeight {
    tier: String!
    weight: Float!
}

"The formula the scores came from; its version changes whenever the formula does."
type ImpactScoring {
    version: String!
    formula: String!
    tierWeights: [TierWeight!]!
    pathMatchBoost: Float!
}

type ImpactEnvironment {
    id: ID!
    key: String!
    "production, pre_production, development or other: what the hit was weighted by."
    tier: String!
}

"The facts a hit rests on: the node, the path that reached it, and where the node came from."
type Citation {
    nodeKey: ID!
    edgePath: [ImpactStep!]!
    provenance: Provenance!
}

type ImpactOwner {
    team: GraphNode!
    via: [ImpactStep!]!
    confidence: Float!
}

type ImpactHit {
    node: GraphNode!
    hops: Int!
    "min(1, 1 / (1 + hops) * tierWeight * pathBoost), scoring version 1."
    score: Float!
    confidence: Float!
    inferred: Boolean!
    tier: String!
    environment: ImpactEnvironment
    pathMatched: Boolean!
    owners: [ImpactOwner!]!
    citation: Citation!
}

type ChangeImpact {
    repository: GraphNode!
    depth: Int!
    limit: Int!
    scoring: ImpactScoring!
    "not_requested, not_applied (no index to read the paths against) or applied."
    pathFilter: String!
    matchedPaths: [String!]!
    "not_requested; applied (deployments limited to those carrying a Change the sha names); or unknown (no Change matches it)."
    changeScope: String!
    "True when there were more hits than limit; how many more is not said."
    truncated: Boolean!
    "Score descending, then hops ascending, then node id ascending."
    hits: [ImpactHit!]!
}

# Reading the graph as of an instant (#93). Without asOf, the current view.

extend type Query {
    """
    A node by its Type:key id, or null. With asOf, an ISO-8601 instant, the node as the graph held it then: null
    unless its [validFrom, validTo) contains the instant (#93).
    """
    node(id: ID!, asOf: String): GraphNode
    """
    Every relationship touching a node, under the name this end sees. direction is in, out or both. With asOf,
    only the relationships whose [validFrom, validTo) contains the instant, to a node valid then too (#93).
    """
    edges(nodeId: ID!, direction: String = "both", edgeType: String, asOf: String): [NodeEdge!]!
}

"A relationship as one of its ends sees it (#93): its name from this end, and the node at the other."
type NodeEdge {
    type: String!
    inverse: String!
    "OUTGOING when this node is the edge's source, INCOMING when it is the target."
    direction: String!
    displayName: String!
    other: GraphNode!
    provenance: Provenance!
}

extend type Provenance {
    """
    True when the fact is current and its source has not stated it again within the source's freshness window,
    which GET /api/v1/ontology publishes (#93). Computed when read; a fact that has ended is never stale.
    """
    stale: Boolean!
}
