{
  "name": "repodatagraph-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "test:unit": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test:unit -- --run && npm run build"
  },
  "dependencies": {
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "axios": "^1.6.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vue": "^10.3.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.4",
    "prettier": "^3.6.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^5.2.8",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.0.6"
  }
}
