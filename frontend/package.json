{
  "name": "repodatagraph-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "test:unit": "vitest",
    "pretest:contract": "node scripts/clean-pacts.mjs",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "verify": "npm run lint && npm run typecheck && npm run test:unit -- --run && npm run test:contract && npm run build"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "vue": "^3.5.42",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@pact-foundation/pact": "^17.1.4",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.4",
    "prettier": "^3.6.2",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
