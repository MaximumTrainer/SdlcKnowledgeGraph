{
  "name": "repodatagraph-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "test:unit": "vitest",
    "pretest:contract": "node scripts/clean-pacts.mjs",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "verify": "npm run lint && npm run typecheck && npm run test:unit -- --run && npm run test:contract && npm run build"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cytoscape": "^3.34.3",
    "cytoscape-dagre": "^2.5.0",
    "oidc-client-ts": "^3.5.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pact-foundation/pact": "^17.1.4",
    "@types/cytoscape": "^3.31.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "msw": "^2.10.4",
    "prettier": "^3.9.9",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.12"
  }
}
