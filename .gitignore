# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# Gradle build output
build/
.gradle/

# Node.js dependencies and build output
node_modules/
dist/
.npm/
coverage/

# Playwright output
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
website/test-results/
website/playwright-report/

# VitePress build cache. The built site itself lands in .vitepress/dist, covered by dist/ above.
website/.vitepress/cache/

# IDE files
.idea/
*.iml
.vscode/

# OS files
.DS_Store
.copilot-specs-cache/

# Claude Code local session files. The skills under .claude/skills/ describe how work is done
# in this repository, so they are shared; settings and session state stay local.
.claude/*
!.claude/skills/
